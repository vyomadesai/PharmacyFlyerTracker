# Per-stop arrival check-in: rep GPS must be within this many miles of the stop
CHECK_IN_RADIUS_MILES=5000

# Start-of-day route build: include doctor locations within this many miles of rep GPS
ROUTE_PLANNER_RADIUS_MILES=5000

# Local NPI registry: max radius for adding NPI-only stops at check-in (capped at 15)
NPI_REGISTRY_RADIUS_MILES=5

# Per-stop enrichment: search local NPI registry within this many miles of the stop
NPI_REGISTRY_ENRICHMENT_RADIUS_MILES=0.5

# Daily work area around the rep's check-in GPS (miles)
CHECK_IN_DISCOVERY_RADIUS_MILES=5

# No daily stop cap. Every office inside CHECK_IN_DISCOVERY_RADIUS_MILES is assigned.
# CHECK_IN_MAX_STOPS_PER_DAY is ignored.

# Set true to supplement local NPI registry with live NPPES API at each stop
ROUTE_THREE_USE_LIVE_NPPES=false
